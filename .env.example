# Copie ce fichier en ".env" (dans le même dossier) puis colle tes clés.
# Toutes les clés sont optionnelles : sans elles, les outils concernés
# fonctionnent en mode réduit ou expliquent comment obtenir la clé.

# Shodan (https://account.shodan.io) : détails complets d'une IP
# (bannières des services, organisation, historique). Un compte gratuit suffit
# pour une clé, certaines données demandent un abonnement.
SHODAN_API_KEY=

# Have I Been Pwned (https://haveibeenpwned.com/API/Key) : fuites de données
# contenant une adresse e-mail. Clé payante (quelques euros par mois).
HIBP_API_KEY=
